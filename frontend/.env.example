# ==========================================================
# FRONTEND ENVIRONMENT VARIABLES (Vite / Vercel)
# ==========================================================

# 1. FastAPI Backend API Base URL (Render URL in production or localhost for local dev)
VITE_API_URL=http://localhost:8000/api

# 2. Supabase Configuration (Authentication & Live Database Sync)
# Obtain these from your Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
