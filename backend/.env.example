# 1. Database Configuration (Supabase PostgreSQL / Render PostgreSQL)
# For local SQLite: sqlite:///./rural_advisory.db
# For production Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres.yourprojectid:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./rural_advisory.db

# 2. Groq Cloud LPU API Key (Priority Ultra-Fast Inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# 3. Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 4. Optional OpenAI Key (fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 5. Frontend URL for CORS (Vercel deployment URL)
FRONTEND_URL=https://samarth-ai-blue.vercel.app

